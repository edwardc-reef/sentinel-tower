# ==============================================================================
# Django Core
# ==============================================================================

# ENV: Application environment identifier
# Values: backend-dev, backend-prod
ENV=backend-prod

# DEBUG: Enable Django debug mode (never enable in production)
# Values: 1, 0
DEBUG=0

# DEBUG_TOOLBAR: Enable Django Debug Toolbar (requires DEBUG=1)
# Values: 1, 0
DEBUG_TOOLBAR=0

# SECRET_KEY: Django secret key for cryptographic signing
# SECURITY: Must be unique and unpredictable in production
SECRET_KEY=

# ALLOWED_HOSTS: Comma-separated list of allowed hostnames
# SECURITY: Must be set to actual domain(s) in production
ALLOWED_HOSTS=

# LOG_LEVEL: Root logging level
# Values: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Media files storage path (inside container)
MEDIA_ROOT=/var/media

# MEDIA_VOLUME_PATH: Host path for media files volume mount
# Default: ./media (relative to compose project)
MEDIA_VOLUME_PATH=./media

# ==============================================================================
# Database (PostgreSQL)
# ==============================================================================

POSTGRES_DB=project
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# PostgreSQL memory, planner and observability tuning.
# Full rationale and measurements: docs/postgres-tuning.md
#
# WARNING: these values override the defaults in envs/prod/docker-compose.yml.
# Sizing below assumes the current prod host: 7.7 GB RAM, NO SWAP, ~4.3 GB
# already used by the app stack. Re-check docs/postgres-tuning.md before
# raising anything on a host with a different memory budget.

# Memory. 1GB is 8x the 128MB stock default and leaves the OS ~2.4 GB of page
# cache. Raise to 2GB (and effective_cache_size to 4GB) only once the host has
# more RAM -- 2GB today leaves ~1.4 GB of page cache and risks the OOM killer.
POSTGRES_SHARED_BUFFERS=1GB
# Must reflect memory the host ACTUALLY has free. Too high and the planner
# assumes data is cached when it isn't, and picks plans that then hit disk.
POSTGRES_EFFECTIVE_CACHE_SIZE=3GB
# Per sort node PER CONNECTION, not global. Do not raise casually.
POSTGRES_WORK_MEM=32MB

# Planner. SSD, but a network-attached Hetzner Cloud Volume -- cheaper than
# spinning disk (4), dearer than local NVMe (1.1).
POSTGRES_RANDOM_PAGE_COST=1.5

# Checkpoints / WAL. The 1GB default for max_wal_size caused 115 forced checkpoints and left the
# DB writing checkpoints ~79% of wall-clock time.
POSTGRES_MAX_WAL_SIZE=4GB
POSTGRES_MIN_WAL_SIZE=1GB

# Observability. 5000 entries was evicting 89k times/day, so occasional Grafana
# dashboard queries never survived long enough to be seen.
POSTGRES_PGSS_MAX=50000
# ms. Log full text + duration of anything slower than this.
POSTGRES_LOG_MIN_DURATION=2000
# kB. Catches work_mem overflow spilling to disk.
POSTGRES_LOG_TEMP_FILES=10240
# ms. auto_explain logs the ACTUAL plan (with buffer hit/read counts) above this.
POSTGRES_AUTOEXPLAIN_MIN_DURATION=5000

POSTGRES_MAINTENANCE_WORK_MEM=256MB
POSTGRES_AUTOVACUUM_VACUUM_COST_LIMIT=2000

# POSTGRES_DATA_PATH: Host path for PostgreSQL data directory
# Default: ./db/data (relative to compose project)
POSTGRES_DATA_PATH=./db/data

DATABASE_URL=postgres://postgres:@db:5432/project

# ==============================================================================
# Redis
# ==============================================================================


REDIS_HOST=redis
REDIS_PORT=6379

# ==============================================================================
# Celery (Task Queue)
# ==============================================================================

# CELERY_BROKER_URL: Redis URL for Celery message broker
CELERY_BROKER_URL=redis://redis:6379/0

# CELERY_TASK_ALWAYS_EAGER: Execute tasks synchronously (1=sync, 0=async)
# Use 1 for development, 0 for production
CELERY_TASK_ALWAYS_EAGER=0
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_BROKER_POOL_LIMIT=50

# Worker concurrency (number of concurrent worker processes per queue)
CELERY_MASTER_CONCURRENCY=2
CELERY_METAGRAPH_CONCURRENCY=2

# Celery Flower monitoring dashboard credentials
CELERY_FLOWER_USER=flower
CELERY_FLOWER_PASSWORD=

# ==============================================================================
# Web Server & CORS
# ==============================================================================

NGINX_HOST=

# CORS_ENABLED: Enable Cross-Origin Resource Sharing
CORS_ENABLED=1

# CORS_ALLOWED_ORIGINS: Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=

# CORS_ALLOWED_ORIGIN_REGEXES: Comma-separated regex patterns for allowed origins
CORS_ALLOWED_ORIGIN_REGEXES=

# CORS_ALLOW_ALL_ORIGINS: Allow all origins (use only in development)
CORS_ALLOW_ALL_ORIGINS=0

# ==============================================================================
# Bittensor Network
# ==============================================================================

# BITTENSOR_ARCHIVE_NETWORK: Archive node for querying old blocks
# Used automatically when block is >300 blocks behind chain head
# Values: archive, finney, local, testnet
BITTENSOR_ARCHIVE_NETWORK=archive

# ==============================================================================
# Sentinel Mode
# ==============================================================================

# SENTINEL_MODE: Block processing mode
# Values:
#   live          - Real-time block processing, follows chain head (default)
#   backfill      - Legacy sequential backfill with rate limiting
#   fast_backfill - Lite APY-only synchronous backfill (single connection, no Celery)
#   apy_backfill  - Lite APY-only backfill tuned for throughput (batch_size=50, delay=0.5s)
SENTINEL_MODE=live

# BLOCK_START / BLOCK_END: Block range boundaries
# Required when SENTINEL_MODE=backfill, fast_backfill, or apy_backfill
BLOCK_START=
BLOCK_END=

# NETUID: Specific subnet UID to backfill (optional, default: all configured netuids)
# Used in fast_backfill and apy_backfill modes
NETUID=

# BACKFILL_RATE_LIMIT: Seconds between blocks in backfill mode
BACKFILL_RATE_LIMIT=1.0

# BACKFILL_STEP: Block step size for fast_backfill and apy_backfill modes (default: 1)
BACKFILL_STEP=1

# BACKFILL_BATCH_SIZE: Blocks per Celery task
# Default: 10 (fast_backfill), 50 (apy_backfill)
BACKFILL_BATCH_SIZE=10

# BACKFILL_BATCH_DELAY: Seconds between spawning batch tasks
# Default: 1.0 (fast_backfill), 0.5 (apy_backfill)
BACKFILL_BATCH_DELAY=1.0

# ==============================================================================
# Historical Metagraph Backfill Daemon
# ==============================================================================
# Long-running daemon (compose profile: historical-backfill) that walks the
# fixed range [HISTORICAL_BACKFILL_BLOCK_START, HISTORICAL_BACKFILL_BLOCK_END]
# and dumps one lite metagraph snapshot per epoch (epoch start), per subnet,
# oldest-first. Uses a single archive websocket connection per pass; the chain
# head is never queried. After each pass, sleeps HISTORICAL_BACKFILL_SLEEP_SECONDS
# and re-runs to retry any failed fetches. Requires BITTENSOR_ARCHIVE_NETWORK.

# HISTORICAL_BACKFILL_BLOCK_START: Oldest block to cover (required).
HISTORICAL_BACKFILL_BLOCK_START=

# HISTORICAL_BACKFILL_BLOCK_END: Newest block to cover (inclusive).
# Defaults to HISTORICAL_BACKFILL_BLOCK_START + 2,000,000.
HISTORICAL_BACKFILL_BLOCK_END=

# HISTORICAL_BACKFILL_NETUIDS: CSV of netuids; defaults to METAGRAPH_NETUIDS
# (or all 1-128 if that is also unset). Lets this daemon run on a different
# subnet scope than the live sync.
HISTORICAL_BACKFILL_NETUIDS=

# HISTORICAL_BACKFILL_RATE_LIMIT: Seconds between fetches (default 1.0)
HISTORICAL_BACKFILL_RATE_LIMIT=1.0

# HISTORICAL_BACKFILL_SLEEP_SECONDS: Seconds to sleep between full passes
# (default 3600)
HISTORICAL_BACKFILL_SLEEP_SECONDS=3600

# HISTORICAL_BACKFILL_FORCE_REFRESH: When set to 1/true/yes, re-fetches every
# (block, netuid) in the range, ignoring MetagraphDump dedup. Use to refresh
# rows after schema changes (e.g. new fields like alpha_stake added to
# NeuronSnapshot). Idempotent for the snapshot rows themselves
# (update_or_create on (neuron, block)). Default: unset (dedup enabled).
HISTORICAL_BACKFILL_FORCE_REFRESH=

# ==============================================================================
# Metagraph Configuration
# ==============================================================================

# METAGRAPH_NETUIDS: Comma-separated list of subnet UIDs to sync
# Empty = all subnets (1-128)
# Example: METAGRAPH_NETUIDS=1,8,19
METAGRAPH_NETUIDS=

# METAGRAPH_LITE: Enable lite mode (excludes weights and bonds data)
# Values: 0 (full mode), 1 (lite mode)
METAGRAPH_LITE=0

# Data retention windows in days; validator APY data is kept forever regardless.
# DATA_RETENTION_DAYS: non-validator neuron snapshots + mechanism metrics.
# DATA_RETENTION_BULK_DAYS: bulk tables (weight, bond, collateral, extrinsics).
DATA_RETENTION_DAYS=90
DATA_RETENTION_BULK_DAYS=40
DATA_RETENTION_BATCH_SIZE=20000
DATA_RETENTION_BATCH_SLEEP_SECONDS=0.2

# ==============================================================================
# Sentinel Storage (S3)
# ==============================================================================

# S3 backend configuration (leave empty to use local filesystem only)
SENTINEL_STORAGE_S3_BUCKET=
SENTINEL_STORAGE_S3_BASE_PATH=
SENTINEL_STORAGE_S3_AWS_REGION=
SENTINEL_STORAGE_S3_AWS_ACCESS_KEY_ID=
SENTINEL_STORAGE_S3_AWS_SECRET_ACCESS_KEY=

# ==============================================================================
# Discord Alerts
# ==============================================================================

# Real-time webhook notifications when matching extrinsics are detected
# Create webhooks: Discord > Server Settings > Integrations > Webhooks
DISCORD_SUDO_ALERTS_WEBHOOK_URL=
DISCORD_ADMIN_UTILS_ALERTS_WEBHOOK_URL=
DISCORD_SUBNET_REGISTRATION_WEBHOOK_URL=
DISCORD_COLDKEY_SWAP_WEBHOOK_URL=

# ==============================================================================
# Monitoring (Grafana)
# ==============================================================================

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# ==============================================================================
# Logging (Loki)
# ==============================================================================

LOKI_URL=https://loki.reef.pl
LOKI_REFRESH_INTERVAL=5s
LOKI_USER=
LOKI_PASSWORD=
LOKI_CLIENT=
LOKI_CLIENT_SERVER_GROUP=

# ==============================================================================
# Error Tracking (Sentry)
# ==============================================================================

# SENTRY_DSN: Sentry Data Source Name (leave empty to disable)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

PROMETHEUS_EXPORT_MIGRATIONS=1
# Optional dedicated read-only roles so DB usage by monitoring and Grafana dashboards
# can be told apart from the application's (docs/README.md, "Database roles").
# Per pair: fill BOTH or NEITHER, and create the role before filling.
# Left blank, both fall back to POSTGRES_USER.
POSTGRES_EXPORTER_USER=
POSTGRES_EXPORTER_PASSWORD=
GRAFANA_READER_USER=
GRAFANA_READER_PASSWORD=
HTTPS_REDIRECT=1

# ==============================================================================
# Docker (cadvisor)
# ==============================================================================

# DOCKER_ROOT_DIR: Docker data root directory
# Override when Docker stores data on a non-default path (e.g., mounted volume)
# Default: /var/lib/docker
DOCKER_ROOT_DIR=/var/lib/docker

# ==============================================================================
# Backups (Backblaze B2)
# ==============================================================================

BACKUP_LOCAL_ROTATE_KEEP_LAST=10
BACKUP_B2_BUCKET=
BACKUP_B2_FOLDER=
BACKUP_B2_APPLICATION_KEY_ID=
BACKUP_B2_APPLICATION_KEY=
