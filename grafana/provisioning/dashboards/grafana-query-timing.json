    {
      "id": 10,
      "type": "heatmap",
      "title": "Plugin request duration distribution",
      "description": "Histogram buckets of plugin queryData duration for the plugins selected in the Plugin dropdown. Darker cells mean more requests landed in that latency bucket. The top bucket is 10 s; slower requests fall into +Inf.",
