            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(grafana_plugin_request_duration_seconds_bucket{endpoint=\"queryData\",plugin_id=~\"postgres|grafana-postgresql-datasource\",job=\"$job\"}[5m])))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Query requests / s (5m)",
      "description": "Rate of /api/ds/query requests over the last 5 minutes. One request carries all queries of one panel.",
