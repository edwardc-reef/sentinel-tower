{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Where a Grafana instance spends time answering dashboard queries: whole request vs time inside the data source plugin, per plugin. Source: the instance's own /metrics scraped by Prometheus; pick the instance with the Grafana instance dropdown.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Grafana metrics in Prometheus",
      "description": "Counts Grafana instances whose /metrics Prometheus is scraping for the selected job (grafana_build_info). 0 means Prometheus has no Grafana metrics and every panel below stays empty: the `grafana` job in prometheus/prometheus.yml must target grafana:3000, and Prometheus must be reloaded after the file changes (curl -X POST http://127.0.0.1:9090/-/reload on the host).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "NOT SCRAPED — Prometheus has no Grafana metrics; check the grafana scrape job and reload Prometheus (see panel info)",
                  "color": "red",
                  "index": 0
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 1,
                "to": 1000,
                "result": {
                  "text": "OK — Grafana metrics are being scraped",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "noValue": "NOT SCRAPED — no Grafana metrics in Prometheus"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "count(grafana_build_info{job=\"$job\"}) or vector(0)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Query request p95 (5m)",
      "description": "95th percentile of the whole /api/ds/query request as seen by Grafana's HTTP server, last 5 minutes. This is the full time a panel waits for its data, all data sources combined. Grafana's histogram tops out at 10 s, so anything slower is reported as 10 s here; use the mean and the slow-share panels for queries beyond that.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 3
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "mappings": [],
          "noValue": "no data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(grafana_http_request_duration_seconds_bucket{handler=\"/api/ds/query\",job=\"$job\"}[5m])))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Postgres plugin p95 (5m)",
      "description": "95th percentile of time spent inside the PostgreSQL data source plugin (query execution on db plus result conversion), last 5 minutes. Grafana's histogram tops out at 10 s, so anything slower is reported as 10 s here; use the mean and the slow-share panels for queries beyond that.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 3
