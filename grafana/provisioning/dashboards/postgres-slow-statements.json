  "description": "Slow, cancelled and failed Postgres statements with their SQL, from the db container log in Loki, filterable by the Postgres role. Complements DB Query Performance (pg_stat_statements: cumulative, no cancelled statements) and Grafana Query Timing (Grafana-side latency, no query identity).",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Slow statements",
      "description": "Statements over the log threshold that completed in the selected range. Source: the db container log shipped to Loki by Alloy. Postgres logs every statement slower than log_min_duration_statement (2 s on prod) with its duration and full SQL, and every cancelled or failed statement with its text. Nothing faster than that threshold appears here. The DB user dropdown filters by the Postgres role from the log prefix (lines since 2026-09-05).",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({container=\"$db_container\", db_user=~\"$db_user\"} |~ \"duration: [0-9.]+ ms  statement:\" [$__range]))",
          "queryType": "instant"
        }
      ]
    },
