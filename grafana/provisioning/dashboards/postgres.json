    {
      "id": 9,
      "type": "table",
      "title": "Top 10 queries by total time \u2014 with query text (since stats reset)",
      "description": "Read directly from pg_stat_statements via the PostgreSQL datasource, so the actual SQL is visible. Cumulative since the last pg_stat_statements_reset(); the panels below give the time-bounded view.",
      "datasource": {
        "type": "postgres",
        "uid": "postgresql"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgresql"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT r.rolname AS \"user\",\n       s.calls,\n       round((s.total_exec_time / 1000)::numeric, 1) AS total_s,\n       round(s.mean_exec_time::numeric, 2) AS mean_ms,\n       s.rows,\n       left(regexp_replace(s.query, '\\s+', ' ', 'g'), 200) AS query\nFROM pg_stat_statements s\nJOIN pg_roles r ON r.oid = s.userid\nJOIN pg_database d ON d.oid = s.dbid\nWHERE d.datname = '${datname}'\nORDER BY s.total_exec_time DESC\nLIMIT 10",
          "editorMode": "code"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "total_s"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "mean_ms"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "calls"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "rows"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "user"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 150
              }
            ]
          }
        ]
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Top 10 queries by time consumed \u2014 selected time range",
      "description": "Total execution time each query consumed over the dashboard's time range. Look the queryid up in the table above to get the SQL. Query text is joined in from pg_stat_statements via the PostgreSQL datasource.",
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "topk(10, sum by (queryid, user) (increase(pg_stat_statements_seconds_total{datname=\"$datname\"}[$__range])))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "table",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgresql"
          },
          "refId": "B",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT s.queryid::text AS queryid,\n       min(left(regexp_replace(s.query, '\\s+', ' ', 'g'), 200)) AS query\nFROM pg_stat_statements s\nJOIN pg_database d ON d.oid = s.dbid\nWHERE d.datname = '${datname}'\nGROUP BY s.queryid\nORDER BY max(s.total_exec_time) DESC\nLIMIT 1000",
          "editorMode": "code"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "queryid",
            "mode": "inner"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true
            },
            "renameByName": {
              "Value #A": "total time",
              "Value": "total time"
            },
            "indexByName": {
              "query": 0,
              "user": 1,
              "total time": 2,
              "queryid": 3
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "total time",
                "desc": true
              }
            ]
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "total time"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.width",
                "value": 220
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "gradient"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "continuous-BlYlRd"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "user"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 150
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "queryid"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 170
              }
            ]
          }
        ]
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Top 10 queries by time consumed \u2014 over time",
      "description": "Execution-seconds per wall-clock second, 5m average: 1.0 = this query kept one core busy full-time. Membership of the top 10 is re-evaluated at every point, so lines start and stop.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "topk(10, sum by (queryid, user) (rate(pg_stat_statements_seconds_total{datname=\"$datname\"}[5m])))",
          "legendFormat": "{{queryid}} ({{user}})",
          "range": true,
          "instant": false,
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 2,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": []
      }
    },
    {
