    {
      "id": 16,
      "type": "table",
      "title": "Slowest queries per execution \u2014 selected time range",
      "description": "Mean execution time per call over the dashboard's time range. Complements the 'time consumed' ranking: a query can be slow without being a big share of total load. Query text is joined in from pg_stat_statements via the PostgreSQL datasource.",
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "gridPos": {
        "x": 12,
        "y": 34,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "topk(10, sum by (queryid, user) (increase(pg_stat_statements_seconds_total{datname=\"$datname\"}[$__range])) / (sum by (queryid, user) (increase(pg_stat_statements_calls_total{datname=\"$datname\"}[$__range])) >= 5))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "table",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgresql"
          },
          "refId": "B",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT s.queryid::text AS queryid,\n       min(left(regexp_replace(s.query, '\\s+', ' ', 'g'), 200)) AS query\nFROM pg_stat_statements s\nJOIN pg_database d ON d.oid = s.dbid\nWHERE d.datname = '${datname}'\nGROUP BY s.queryid\nORDER BY max(s.total_exec_time) DESC\nLIMIT 1000",
          "editorMode": "code"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "queryid",
            "mode": "inner"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true
            },
            "renameByName": {
              "Value #A": "mean time",
              "Value": "mean time"
            },
            "indexByName": {
              "query": 0,
              "user": 1,
              "mean time": 2,
              "queryid": 3
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "mean time",
                "desc": true
              }
            ]
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "mean time"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 3
              },
              {
                "id": "custom.width",
                "value": 220
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "gradient"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "continuous-BlYlRd"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "user"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 150
              }
            ]
          },
          {
            "matcher": {
