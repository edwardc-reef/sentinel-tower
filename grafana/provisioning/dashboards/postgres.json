    {
      "id": 13,
      "type": "timeseries",
      "title": "Rows per second",
      "description": "Ingestion throughput as the database sees it. Inserted dropping to 0 while the sync daemons run means ingestion is stuck.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "rate(pg_stat_database_tup_inserted{datname=\"$datname\"}[5m])",
          "legendFormat": "inserted",
          "range": true,
          "instant": false,
          "format": "time_series",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "rate(pg_stat_database_tup_updated{datname=\"$datname\"}[5m])",
          "legendFormat": "updated",
          "range": true,
          "instant": false,
          "format": "time_series",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "rate(pg_stat_database_tup_deleted{datname=\"$datname\"}[5m])",
          "legendFormat": "deleted",
          "range": true,
          "instant": false,
          "format": "time_series",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "D",
          "expr": "rate(pg_stat_database_tup_fetched{datname=\"$datname\"}[5m])",
          "legendFormat": "fetched",
