    {
      "id": 28,
      "type": "stat",
      "title": "Since last autoanalyze",
      "description": "Time since autovacuum last analyzed any user table. The bloat figures are estimated from these statistics, so a stale value here means stale bloat numbers.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 9,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
