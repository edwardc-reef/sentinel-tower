    {
      "id": 9,
      "type": "table",
      "title": "Top queries \u2014 by total time and per execution \u2014 selected time range",
      "description": "Union of the 10 queries that consumed the most total time and the 10 slowest per execution (at least 5 calls) in the selected range. Sorted by total time \u2014 click the 'mean time' header to re-rank by per-execution latency; both top-10 sets are always included, so either sort order is complete.",
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 11
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (queryid, user) (increase(pg_stat_statements_seconds_total{datname=\"$datname\"}[$__range])) and (topk(10, sum by (queryid, user) (increase(pg_stat_statements_seconds_total{datname=\"$datname\"}[$__range]))) or topk(10, sum by (queryid, user) (increase(pg_stat_statements_seconds_total{datname=\"$datname\"}[$__range])) / (sum by (queryid, user) (increase(pg_stat_statements_calls_total{datname=\"$datname\"}[$__range])) >= 5)))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "table",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "sum by (queryid, user) (increase(pg_stat_statements_calls_total{datname=\"$datname\"}[$__range])) and (topk(10, sum by (queryid, user) (increase(pg_stat_statements_seconds_total{datname=\"$datname\"}[$__range]))) or topk(10, sum by (queryid, user) (increase(pg_stat_statements_seconds_total{datname=\"$datname\"}[$__range])) / (sum by (queryid, user) (increase(pg_stat_statements_calls_total{datname=\"$datname\"}[$__range])) >= 5)))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "table",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "sum by (queryid, user) (increase(pg_stat_statements_rows_total{datname=\"$datname\"}[$__range])) and (topk(10, sum by (queryid, user) (increase(pg_stat_statements_seconds_total{datname=\"$datname\"}[$__range]))) or topk(10, sum by (queryid, user) (increase(pg_stat_statements_seconds_total{datname=\"$datname\"}[$__range])) / (sum by (queryid, user) (increase(pg_stat_statements_calls_total{datname=\"$datname\"}[$__range])) >= 5)))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "table",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgresql"
          },
          "refId": "D",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT s.queryid::text AS queryid,\n       min(left(regexp_replace(s.query, '\\s+', ' ', 'g'), 200)) AS query\nFROM pg_stat_statements s\nJOIN pg_database d ON d.oid = s.dbid\nWHERE d.datname = '${datname}'\nGROUP BY s.queryid\nORDER BY max(s.total_exec_time) DESC\nLIMIT 1000",
          "editorMode": "code"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "queryid",
            "mode": "inner"
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "alias": "mean time",
            "binary": {
              "left": "Value #A",
              "operator": "/",
              "right": "Value #B"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "user 2": true,
              "user 3": true,
              "__name__": true
            },
            "renameByName": {
              "Value #A": "total time",
              "Value #B": "calls",
              "Value #C": "rows",
              "user 1": "user"
            },
            "indexByName": {
              "query": 0,
              "user": 1,
              "user 1": 1,
              "total time": 2,
              "calls": 3,
              "mean time": 4,
              "rows": 5,
              "queryid": 6
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "total time",
                "desc": true
              }
            ]
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "total time"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.width",
                "value": 200
              },
              {
