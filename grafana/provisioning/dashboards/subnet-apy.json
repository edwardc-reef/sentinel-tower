        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Subnet avg" },
            "properties": [
              { "id": "custom.lineWidth", "value": 3 },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }
            ]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 22 },
      "id": 10,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgresql"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT e.epoch_ts AS time, COALESCE(NULLIF(h.label, ''), LEFT(h.hotkey, 8) || '...') AS metric, e.apy_pct AS value FROM metagraph_validator_apy_epoch e JOIN metagraph_hotkey h ON h.id = e.hotkey_id WHERE e.subnet_id = ${subnet} AND e.epoch_ts IS NOT NULL ORDER BY time",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgresql"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT epoch_ts AS time, 'Subnet avg' AS metric, LEAST((exp(LEAST((2629800.0 / (MIN(tempo) + 1)) * ln(1 + SUM(alpha_dividends)::numeric / NULLIF(SUM(alpha_stake), 0)), 14::numeric)) - 1) * 100, 1000000::numeric) AS value FROM metagraph_validator_apy_epoch WHERE subnet_id = ${subnet} AND epoch_ts IS NOT NULL GROUP BY epoch_ts ORDER BY time",
          "refId": "B"
        }
      ],
      "title": "Validator APY per epoch",
      "type": "timeseries"
    },
