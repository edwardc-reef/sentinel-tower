    {
      "datasource": {
        "type": "postgres",
        "uid": "postgresql"
      },
      "description": "Per-validator APY for the selected subnet, read from `metagraph_validator_apy_epoch` (one row per validator per completed epoch). Each row's `apy_pct` annualizes that single epoch's realized return by compounding: `((1 + alpha_dividends / alpha_stake) ^ epochs_per_year - 1) \u00d7 100`. `Latest Epoch APY` is the most recent epoch's value; `apy_1d` / `apy_1w` / `apy_1m` are averages of per-epoch APY over the trailing window, anchored on the table's global `MAX(epoch_ts)` (not this subnet's own latest epoch, and not Grafana's time picker) \u2014 a subnet with no epoch in the trailing month shows no rows. Caveats: single-epoch APY is volatile epoch-to-epoch; `alpha_stake` is the current per-uid stake rather than the chain's exact epoch-start base; multi-mechanism subnets only use mech_id = 0.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "alpha_stake_tao"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "displayName",
                "value": "Alpha Stake"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "mode": "gradient",
                  "type": "gauge"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "stake_tao"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "displayName",
                "value": "Total Stake"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "apy_epoch"
            },
            "properties": [
              {
