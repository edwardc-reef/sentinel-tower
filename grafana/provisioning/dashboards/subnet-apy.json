                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "displayName",
                "value": "Latest Epoch APY"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "apy_1d"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "displayName",
                "value": "1d APY"
              }
            ]
